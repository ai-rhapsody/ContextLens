{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextLens",
  "version": "0.1.0",
  "identifier": "dev.contextlens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "ContextLens",
        "url": "index.html",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "create": false
      },
      {
        "label": "popup",
        "title": "ContextLens 翻譯",
        "url": "index.html",
        "width": 440,
        "height": 420,
        "minWidth": 340,
        "minHeight": 220,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "create": false,
        "dragDropEnabled": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Hotkey capture, instant translation and a tutor mode",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQjQyNjJDMEU1OUEzMTIKUldRU28xa09MQ2EwY1FVdDE3c0paSjZpK0hyRnQ5VUx6cHhHMHozWmFVV0dKTkp1TkVjaTBQdjgK",
      "endpoints": [
        "https://github.com/dalof41014/contextlens/releases/latest/download/latest.json"
      ]
    }
  }
}
